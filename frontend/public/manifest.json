{
  "manifest_version": 3,
  "name": "Nocturne YouTube Extension",
  "version": "1.0.0",
  "key": "",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.execute-api.us-east-1.amazonaws.com/*"
    "https://extension-s3-uploads-develop.s3.amazonaws.com/*"
  ]
}
