{
  "manifest_version": 3,
  "name": "Nocturne YouTube Extension",
  "version": "1.0.0",
  "key": "",
  "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
  "action": {
    "default_title": "Nocturne",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "notifications",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.execute-api.us-east-1.amazonaws.com/*",
    "https://extension-s3-uploads-develop.s3.amazonaws.com/*"
  ]
}
