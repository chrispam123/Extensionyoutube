# =============================================================================
# Nocturne Frontend — Variables de Entorno
# =============================================================================
# Vite las inyecta automáticamente.
# Para desarrollo local con LocalStack:
#   cp frontend/.env.example frontend/.env
#
# ⚠️ NUNCA subir .env al repositorio. Están en .gitignore.
# =============================================================================

# URL base del API Gateway (dev local o AWS)
# Local: http://localhost:4566
# Dev:   https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/develop
# Prod:  https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
VITE_API_URL=

# ID de cliente de Google OAuth (mismo en todos los entornos)
VITE_GOOGLE_CLIENT_ID=
